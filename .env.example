# ---------- Production ----------
ENVIRONMENT=production
DOMAIN=raneparty.ru
PUBLIC_BASE_URL=https://raneparty.ru
ALLOWED_HOSTS=raneparty.ru,www.raneparty.ru
APP_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_48_CHARS_OR_MORE
SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE_SECONDS=86400

# ---------- Event ----------
EVENT_NAME=RANEPARTY
EVENT_DATE=2026-10-31
EVENT_START=22:00
EVENT_AGE=17+
TICKET_PREFIX=RANE
EXPECTED_AMOUNT=500

# ---------- Payment ----------
# Real HTTPS link to the collection/payment page.
PAYMENT_URL=https://example.com/replace-me
PAYMENT_NOTE=После оплаты вернись в бот и пришли чек фотографией или PDF

# ---------- First OWNER ----------
OWNER_USERNAME=owner
OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- PostgreSQL ----------
POSTGRES_DB=raneparty
POSTGRES_USER=raneparty
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Numeric IDs, comma-separated. These users receive receipts and approve/reject applications.
TELEGRAM_ADMIN_IDS=

# ---------- Internal ----------
REDIS_URL=redis://redis:6379/0
RECEIPT_DIR=/app/data/receipts
RECEIPT_MAX_BYTES=10485760
RECEIPT_MAX_IMAGE_PIXELS=25000000
RECEIPT_MAX_PDF_PAGES=5
RECEIPT_OCR_PDF_PAGES=2
LOGIN_MAX_FAILURES=6
LOGIN_WINDOW_SECONDS=300


# ---------- Logging ----------
LOG_LEVEL=INFO
